<header>
  <div class="reading-progress" aria-hidden="true"></div>
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm fixed-top" role="navigation">
    <div class="container portfolio-shell">
      <a class="navbar-brand title" href="{{ '/' | relative_url }}">Donald OKE</a>
      <button
        class="navbar-toggler collapsed navbar-toggler-main"
        type="button"
        data-nav-toggle="navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse navbar-collapse-main" id="navbarNav">
        <ul class="navbar-nav navbar-menu-list flex-nowrap">
          {% for page in site.pages %}
            {% if page.permalink == '/' %}{% assign about_title = page.title %}{% endif %}
          {% endfor %}
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">{{ about_title }}</a>
          </li>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% unless p.permalink == '/' %}
                {% if p.dropdown %}
                  {% assign has_active_child = false %}
                  {% for child in p.children %}
                    {% if page.title == child.title %}{% assign has_active_child = true %}{% endif %}
                  {% endfor %}
                  <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                    <a
                      class="nav-link dropdown-toggle"
                      href="#"
                      id="navbarDropdown"
                      role="button"
                      data-nav-dropdown-toggle="true"
                      aria-haspopup="true"
                      aria-expanded="false"
                    >
                      {{- p.title -}}
                    </a>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                      {% for child in p.children %}
                        {% if child.title == 'divider' %}
                          <div class="dropdown-divider"></div>
                        {% else %}
                          <a
                            class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                            href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                          >
                            {{- child.title -}}
                          </a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </li>
                {% else %}
                  {% assign parent_link = p.permalink | remove: 'index.html' %}
                  {% if p.permalink contains '://' %}
                    {% assign nav_url = p.permalink %}
                  {% elsif p.permalink contains '/blog/' %}
                    {% assign nav_url = '/blog/' %}
                  {% else %}
                    {% assign nav_url = p.url %}
                  {% endif %}
                  <li class="nav-item {% if page.url contains p.url %}active{% endif %}">
                    <a class="nav-link" href="{{ nav_url | relative_url }}">{{ p.title }}</a>
                  </li>
                {% endif %}
              {% endunless %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <li class="nav-item">
              <button id="search-toggle" type="button" title="Search (Ctrl+K)" aria-label="Open search">
                <span class="nav-link"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
              </button>
            </li>
          {% endif %}
          <li class="nav-item theme-switch-item">
            <button class="theme-switch" type="button" data-theme-switch aria-label="Switch to light theme">
              <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"></path></svg>
              <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"></path></svg>
            </button>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
<script>window.PORTFOLIO_SWARM_PRESETS = {{ site.data.swarm | jsonify }};</script>
<script defer src="{{ '/assets/js/custom.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/theme.js' | relative_url }}"></script>
<script defer src="{{ '/assets/js/swarm.js' | relative_url }}"></script>
