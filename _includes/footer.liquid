{% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}{% assign about_page = site.pages | where: 'permalink', '/' | first %}{% assign nav_pages = nav_pages | unshift: about_page %}{% assign current_index = nil %}{% for item in nav_pages %}{% if item.url == page.url %}{% assign current_index = forloop.index0 %}{% endif %}{% endfor %}{% if current_index != nil %}<nav class="page-pager" aria-label="Page navigation">{% assign prev_index = current_index | minus: 1 %}{% assign next_index = current_index | plus: 1 %}{% if prev_index >= 0 %}{% assign previous_page = nav_pages[prev_index] %}<a class="pager-prev" rel="prev" aria-label="Previous page: {{ previous_page.title }}" href="{% if previous_page.permalink == '/' %}{{ '/' | relative_url }}{% elsif previous_page.url contains '/blog/' %}{{ '/blog/' | relative_url }}{% else %}{{ previous_page.url | relative_url }}{% endif %}"><span class="pager-arrow" aria-hidden="true">←</span><span class="pager-label">{{ previous_page.title }}</span></a>{% endif %}{% if next_index < nav_pages.size %}{% assign next_page = nav_pages[next_index] %}<a class="pager-next" rel="next" aria-label="Next page: {{ next_page.title }}" href="{% if next_page.permalink == '/' %}{{ '/' | relative_url }}{% elsif next_page.url contains '/blog/' %}{{ '/blog/' | relative_url }}{% else %}{{ next_page.url | relative_url }}{% endif %}"><span class="pager-label">{{ next_page.title }}</span><span class="pager-arrow" aria-hidden="true">→</span></a>{% endif %}</nav>{% endif %}
